# Local Claude Code tooling config (per-machine permissions, scratch paths)
.claude/

# Generated TTS WAVs for the General voice engine (regenerate with
# scripts/synth-extra-voice.ps1); only the derived .ts file is committed.
scripts/extra-wav

# Voice tooling scratch: synthetic TTS render inputs, recorded real-voice
# test sets, and the throwaway browser recorder page. Local-only — the
# eval/build scripts read these but nothing here is committed.
scripts/wav
scripts/wav-v2
scripts/testset
record-test-set.html

# Local design-tool scratch: artboards published from the Claude Code
# `design` skill (canvas.json + *.dc.html + the big self-contained
# published-canvas HTML). Design exploration only, not app code.
design-canvas/

# Supabase CLI's local cache for the linked project (project ref, pooler
# URL, component versions) — regenerated per machine, nothing to commit.
supabase/.temp/
