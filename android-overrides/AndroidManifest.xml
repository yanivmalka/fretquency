<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the AndroidManifest.xml that `npx cap add android` generates. It is
  the stock Capacitor 8 template PLUS two additions. First: a second <intent-filter> on
  MainActivity for the `com.fretquency.app://auth-callback` deep link,
  so Google's OAuth redirect returns into the app (handled in src/hooks/useAuth
  via @capacitor/app's appUrlOpen) instead of being stranded in a browser tab.

  MainActivity already has `android:launchMode="singleTask"` in the stock
  template, which is what lets the returning deep link resume the existing
  Activity rather than spawning a new one.

  The APK workflow copies this file into the generated android/ project after
  `cap add`. If Capacitor's template changes on a major upgrade, re-diff this
  against a fresh `npx cap add android` and re-apply just the auth-callback
  intent-filter and the permission below.

  Second addition: REQUEST_INSTALL_PACKAGES, for the in-app APK self-update
  (android-overrides/AppUpdaterPlugin.java). The FileProvider below maps the
  plugin's download folder through android-overrides/xml/file_paths.xml.

  Third addition: MODIFY_AUDIO_SETTINGS (+ RECORD_AUDIO), without which the
  WebView's getUserMedia mic request is always denied — see the comment on the
  permission below.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback deep link. Keep in sync with NATIVE_AUTH_REDIRECT
                 in src/utils/supabase.ts and the Supabase Redirect URLs list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.fretquency.app" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <!-- AdMob app id (required — the Google Mobile Ads SDK crashes the app on
             start without it). This is Google's public SAMPLE app id, safe for
             debug builds. Replace with the real "ca-app-pub-…~…" id from the
             AdMob console before a release build; the ad-unit id is separate and
             comes from VITE_ADMOB_ANDROID_BANNER_ID (see .env.example). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this, navigator.vibrate() inside the WebView silently no-ops
         on Android — the haptic.* pulses in src/utils/feedback.ts (button
         taps, right/wrong, the Sound & vibration setting's Vibrate mode) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- In-app self-update: hand a downloaded APK to the system installer.
         Android still asks the user once to allow installs from this app.
         Drop it (and AppUpdaterPlugin) for a Google Play build — Play updates
         the app itself and restricts this permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- getUserMedia({ audio }) inside the WebView (the tuner, guitar-answer
         pitch detection, the personal-voice engine, the mic level meter).
         Capacitor's BridgeWebChromeClient.onPermissionRequest asks for BOTH
         RECORD_AUDIO and MODIFY_AUDIO_SETTINGS and denies the WebView request
         unless every one comes back granted — an undeclared permission always
         comes back denied, so without this line the user taps "Allow" on the
         mic prompt and getUserMedia still fails with NotAllowedError.
         RECORD_AUDIO itself arrives via the speech-recognition plugin's
         manifest; it's repeated here so this doesn't hinge on that plugin. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

</manifest>
